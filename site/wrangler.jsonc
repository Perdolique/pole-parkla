{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pole-parkla",
  "compatibility_date": "2026-08-23",
  "preview_urls": true,

  "routes": [
    {
      "pattern": "poleparkla.ee",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
