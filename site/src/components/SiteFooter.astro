---
import { siteConfig } from '../config'
import { getLocalizedPath, type Locale } from '../i18n/config'
import { ui } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const text = ui[locale]
---

<footer class="site-footer">
  <nav class="footer-inner" aria-label={text.footerLabel}>
    <a href={getLocalizedPath(locale, 'privacy')}>{text.privacyLink}</a>
    {siteConfig.sourceUrl && (
      <>
        <a href={siteConfig.sourceUrl}>{text.sourceLink}</a>
        <a href={`${siteConfig.sourceUrl}/issues`}>{text.feedbackLink}</a>
      </>
    )}
    <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
    <a href="https://perd.dev">{siteConfig.developerName}</a>
  </nav>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-48);
    color: var(--color-canvas);
    background: var(--color-forest);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-24);
    align-items: center;
    width: var(--page-width);
    min-height: 104px;
    margin-inline: auto;
    padding-block: var(--space-12);
  }

  a {
    color: inherit;
    font-size: var(--font-size-small);
  }

  a {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 640px) {
    .footer-inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: var(--space-12);
    }

    a {
      display: flex;
      align-items: center;
      min-height: 48px;
      border-bottom: 1px solid rgb(243 245 239 / 18%);
    }

    a:last-child {
      border-bottom: 0;
    }
  }
</style>
