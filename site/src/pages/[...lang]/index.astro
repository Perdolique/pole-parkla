---
import type { GetStaticPaths } from 'astro'
import LatestRelease from '../../components/LatestRelease.astro'
import ScreenshotGallery from '../../components/ScreenshotGallery.astro'
import { siteConfig } from '../../config'
import { getStaticLocalePaths, type LocaleRouteProps } from '../../i18n/config'
import { ui } from '../../i18n/ui'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPublishedUpdates } from '../../lib/content'

export const getStaticPaths = (() => getStaticLocalePaths()) satisfies GetStaticPaths

const { locale } = Astro.props as LocaleRouteProps
const text = ui[locale]
const [latestRelease] = await getPublishedUpdates(locale)
---

<BaseLayout
  pageTitle={text.homeMeta.title}
  metaDescription={text.homeMeta.description}
  locale={locale}
  route="home"
>
  <section class="hero">
    <h1>Pole parkla</h1>
    <p>{text.heroDescription}</p>

    {siteConfig.googlePlay && (
      <a class="google-play-link" href={siteConfig.googlePlay.url} rel="noreferrer">
        <img
          src={siteConfig.googlePlay.badgePaths[locale]}
          width="180"
          height="54"
          alt={text.googlePlayAlt}
        />
      </a>
    )}
  </section>

  <ScreenshotGallery locale={locale} />
  {latestRelease && <LatestRelease entry={latestRelease} locale={locale} />}
</BaseLayout>

<style>
  .hero {
    width: var(--page-width);
    margin: clamp(var(--space-40), 7vw, var(--space-80)) auto var(--space-40);
  }

  h1 {
    margin: 0 0 var(--space-12);
    color: var(--color-forest);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  p {
    max-width: 590px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.5;
  }

  .google-play-link {
    display: block;
    width: fit-content;
    margin-block-start: var(--space-24);
  }

  .google-play-link img {
    display: block;
    width: auto;
    height: 54px;
  }
</style>
