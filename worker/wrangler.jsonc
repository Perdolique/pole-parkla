{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pole-parkla-recognition",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "WORKERS_AI_GATEWAY_ID": "",
    "OPENAI_MODEL": "gpt-5.4-mini",
    "OPENAI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/replace-account/replace-gateway/openai"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
