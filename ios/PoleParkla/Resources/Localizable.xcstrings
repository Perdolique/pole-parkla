          "stringUnit": {
            "state": "translated",
            "value": "Map and address search"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaart ja aadressiotsing"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта и поиск адреса"
          }
        }
      }
