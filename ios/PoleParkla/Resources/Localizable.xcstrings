    "camera.location.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location while using the app so camera photos can keep a fresh incident point."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba asukoht rakenduse kasutamise ajal, et kaamerafotole saaks lisada värske juhtumipunkti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите геолокацию при использовании приложения, чтобы снимки камеры получили свежую точку нарушения."
          }
        }
      }
    },
    "camera.location.request": {
      "extractionState": "manual",
      "localizations": {
